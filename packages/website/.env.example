# Point the download buttons and the installation guide somewhere other than the
# latest GitHub release. Each value may be a release page or a direct file URL;
# the platform variables fall back to CELESTA_DOWNLOAD_URL.
# Makit does not read .env files: export these in the shell or set them as build
# variables before `pnpm build`.
CELESTA_DOWNLOAD_URL=
CELESTA_DOWNLOAD_URL_MACOS=
CELESTA_DOWNLOAD_URL_WINDOWS=
