{
  // Type-checks the tests together with the src/ they import. `tsc -b test`
  // builds @celesta/media-utils first when its dist/ is missing or stale.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo"
  },
  "include": ["./**/*.mts"],
  "references": [{ "path": "../../media-utils" }]
}
