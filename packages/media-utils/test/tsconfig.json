{
  // Type-checks the TypeScript tests together with the src/ they import.
  // `tsc -b test` builds @celesta/react first when its dist/ is missing or
  // stale; this package itself needs no build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["./**/*.mts"],
  "references": [{ "path": "../../react" }]
}
