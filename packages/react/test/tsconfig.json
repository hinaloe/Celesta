{
  // Type-checks the tests together with the src/ they import.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../node_modules/.cache/test.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["./**/*.mts"]
}
