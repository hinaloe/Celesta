{
  "name": "@celesta/example-delta",
  "private": true,
  "scripts": {
    "score": "python3 make-score-0.7.0.py",
    "export": "celesta-exporter --json --react --overwrite film-0.7.0.tsx delta-0.7.0.mp4 --subtitles delta-0.7.0.ja.srt",
    "export:shorts": "celesta-exporter --json --react --overwrite shorts-0.7.0.tsx delta-0.7.0-shorts.mp4",
    "score:0.6.0": "python3 make-score-0.6.0.py",
    "export:0.6.0": "celesta-exporter --json --react --overwrite film-0.6.0.tsx delta-0.6.0.mp4",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@celesta/code": "workspace:*",
    "@celesta/debug": "workspace:*",
    "@celesta/layout": "workspace:*",
    "@celesta/math": "workspace:*",
    "@celesta/media-utils": "workspace:*",
    "@celesta/react": "workspace:*",
    "@celesta/shader": "workspace:*",
    "@celesta/shapes": "workspace:*",
    "@celesta/text": "workspace:*",
    "@celesta/transitions": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.7.3"
  }
}
